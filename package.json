{
  "name": "yusuf-habib-blog",
  "version": "1.0.0",
  "private": true,
  "description": "Website personal dan blog Yusuf Habib (yusuf-habib.blog)",
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/assets/css/output.css --minify",
    "build": "npm run build:css && node scripts/sitemap.mjs",
    "watch": "npx @tailwindcss/cli -i ./src/input.css -o ./public/assets/css/output.css --watch",
    "serve": "python3 -m http.server 8080 --directory public",
    "dev": "npm run build:css && (trap 'kill 0' EXIT; npm run watch & npm run serve)"
  },
  "devDependencies": {
    "@fontsource/merriweather": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@tailwindcss/cli": "^4.0.0",
    "tailwindcss": "^4.0.0"
  }
}
